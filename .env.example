# ─────────────────────────────────────────────
# PocketSmart AI — Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# Google Gemini API key (required)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name (optional — defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Flask secret key for session signing (required — use a long random string)
FLASK_SECRET_KEY=change_this_to_a_long_random_secret_key

# Flask environment (deprecated in Flask 3.x — do not rely on this)
# Use FLASK_DEBUG instead
# FLASK_ENV=development

# Flask debug mode: True | False (optional — defaults to True in development)
FLASK_DEBUG=True

# Port for local development (optional — defaults to 5000)
PORT=5000
